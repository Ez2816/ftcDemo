  "tasks": [
    {
      "label": "FTC: Run all tests",
      "type": "shell",
      "command": "./gradlew test --console=plain",
      "windows": {
        "command": ".\\gradlew.bat test --console=plain"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
